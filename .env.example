# Copy to .env. Never share this file or commit it.
APP_NAME=JARVIS QUANT AI
APP_MODE=paper
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765
UPSTOX_ACCESS_TOKEN=
# Optional OpenAI-compatible cloud inference endpoint. No provider is enabled by default.
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
# Optional local Ollama endpoint/model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Live orders remain disabled unless this is set AND separately enabled in dashboard.
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PHRASE=I AUTHORIZE LIVE TRADING
